+/// Guest registers can describe a binding that spans a whole memory pool. Caching gigabytes of it
+/// exhausts memory on mobile devices, and no draw reads that much, so bindings are capped here.
+constexpr u32 MAX_BINDING_SIZE = static_cast<u32>(64_MiB);
+
+/// Logs the first oversized requests, to tell which kind of binding asks for them.
+inline void ReportLargeBinding(std::string_view kind, u64 address, u64 size) {
+    static u32 reports = 0;
+    if (size >= MAX_BINDING_SIZE && reports < 16) {
+        ++reports;
+        LOG_WARNING(HW_GPU, "{} buffer request at {:#x} asks for {} MiB", kind, address,
+                    size >> 20);
+    }
+}
+
+inline u32 ClampBindingSize(std::string_view kind, u64 address, u32 size) {
+    ReportLargeBinding(kind, address, size);
+    return (std::min)(size, MAX_BINDING_SIZE);
+}
