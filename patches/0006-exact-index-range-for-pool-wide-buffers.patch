+// The estimate is the size of the memory the index buffer registers span. When a game points
+// them at a whole memory pool it is useless: binding that many indices means caching gigabytes.
+bool IsIndexEstimateUsable(Maxwell3D& maxwell3d, u32 estimate) {
+    static constexpr u64 MAX_ESTIMATED_BYTES = 64ULL << 20;
+    return u64{estimate} * maxwell3d.regs.index_buffer.FormatSizeInBytes() < MAX_ESTIMATED_BYTES;
+}
