         const bool next_qword_is_size = static_cast<u32>(next_qword >> 32) == 0 &&
                                         packed_size != 0 &&
-                                        packed_size <= memory_layout_size;
+                                        packed_size <= memory_layout_size &&
+                                        packed_size < 64_MiB;
         if (next_qword_is_size) {
             return packed_size;
         }
